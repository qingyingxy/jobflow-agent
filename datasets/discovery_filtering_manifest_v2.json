{
  "manifest_version": "discovery-filtering-manifest-v2",
  "dataset_version": "discovery-filtering-fixtures-2026-10-08-v2",
  "purpose": "验证筛选产品的来源授权、工具路由、回退、无需人工接管的空结果处理、默认零分析预算和状态一致性；历史 M12 v1 清单保持不变。",
  "source_policy": "所有场景只允许访问内存 Fixture 或被安全检查器预先拒绝的地址；不发送真实官网请求。",
  "thresholds": {
    "case_pass_rate": {
      "minimum": 1.0
    },
    "unauthorized_source_access_rate": {
      "maximum": 0.0
    },
    "trace_completeness_rate": {
      "minimum": 1.0
    },
    "tool_route_accuracy": {
      "minimum": 1.0
    },
    "fallback_correctness_rate": {
      "minimum": 1.0
    },
    "non_job_false_accept_rate": {
      "maximum": 0.0
    },
    "budget_compliance_rate": {
      "minimum": 1.0
    },
    "state_consistency_rate": {
      "minimum": 1.0
    },
    "empty_result_handling_accuracy": {
      "minimum": 1.0
    }
  },
  "cases": [
    {
      "id": "FILTER-001",
      "category": "source_authorization",
      "fixture": "unknown_company_blocked",
      "description": "未登记公司必须在构造 Adapter 前被拒绝，且不能发生网络访问。",
      "expected": {
        "unauthorized_access_occurred": false
      }
    },
    {
      "id": "FILTER-002",
      "category": "source_authorization",
      "fixture": "private_url_blocked",
      "description": "解析到本机地址的 URL 必须在 HTTP 请求发出前被拒绝。",
      "expected": {
        "unauthorized_access_occurred": false
      }
    },
    {
      "id": "FILTER-003",
      "category": "tool_routing",
      "fixture": "bytedance_success",
      "description": "字节来源优先使用专用公开职位 Adapter，并保留完整轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "FILTER-004",
      "category": "tool_routing",
      "fixture": "tencent_success",
      "description": "腾讯来源优先使用专用公开职位 Adapter，并保留完整轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "FILTER-005",
      "category": "adapter_fallback",
      "fixture": "bytedance_failure_static_success",
      "description": "字节专用 Adapter 失败后按计划回退静态岗位链接读取。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "FILTER-006",
      "category": "adapter_fallback",
      "fixture": "tencent_empty_static_success",
      "description": "腾讯专用 Adapter 返回空结果后按计划回退静态岗位链接读取。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "FILTER-007",
      "category": "human_gate",
      "fixture": "dynamic_shell_human_gate",
      "description": "无法静态验证岗位的动态页面不得入库，保留空结果和搜索记录，无需人工补贴 JD。",
      "expected": {
        "discovered_count": 0,
        "trace_complete": true,
        "tool_route_correct": true,
        "non_job_accepted": false,
        "empty_result_handling_correct": true
      }
    },
    {
      "id": "FILTER-008",
      "category": "non_job_rejection",
      "fixture": "guideline_rejected",
      "description": "校园招聘指南页不得误判为具体岗位，保留空结果和搜索记录，无需人工补贴 JD。",
      "expected": {
        "discovered_count": 0,
        "trace_complete": true,
        "tool_route_correct": true,
        "non_job_accepted": false,
        "empty_result_handling_correct": true
      }
    },
    {
      "id": "FILTER-009",
      "category": "structured_extraction",
      "fixture": "jsonld_job_accepted",
      "description": "合法 JobPosting JSON-LD 必须通过统一候选验证并保留来源轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "FILTER-010",
      "category": "failure_isolation",
      "fixture": "source_failure_isolated",
      "description": "一个来源读取失败时，其他来源的有效岗位仍必须保留并继续处理。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "FILTER-011",
      "category": "budget",
      "fixture": "result_and_filter_budget",
      "description": "25 条候选只能保留 20 条，默认自动分析目标为 0。",
      "expected": {
        "discovered_count": 20,
        "strict_count": 20,
        "trace_complete": true,
        "tool_route_correct": true,
        "budget_compliant": true
      }
    },
    {
      "id": "FILTER-012",
      "category": "analysis_gate",
      "fixture": "strict_expanded_gate",
      "description": "显式启用内部分析模式时，仅条件符合的岗位可以进入分析目标。",
      "expected": {
        "discovered_count": 2,
        "strict_count": 1,
        "expanded_count": 1,
        "trace_complete": true,
        "budget_compliant": true
      }
    },
    {
      "id": "FILTER-013",
      "category": "state_idempotency",
      "fixture": "duplicate_rerun_idempotent",
      "description": "同一岗位重复发现不得创建重复 JobPosting 或 CandidateJob。",
      "expected": {
        "discovered_count": 1,
        "duplicate_count": 1,
        "trace_complete": true,
        "state_consistent": true
      }
    }
  ]
}
