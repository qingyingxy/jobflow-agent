{
  "manifest_version": "m19-assisted-apply-manifest-v1",
  "dataset_version": "m19-mock-ats-2026-08-25-v1",
  "purpose": "Verify deterministic ATS field mapping, handoff, and receipt boundaries before Assisted Apply release.",
  "scope_boundary": "Offline structured Mock ATS fixtures only; no live ATS compatibility, real submission success rate, or user workflow duration claim.",
  "thresholds": {
    "field_fill_accuracy": {"minimum": 1.0},
    "resume_version_accuracy": {"minimum": 1.0},
    "human_handoff_accuracy": {"minimum": 1.0},
    "submission_receipt_coverage": {"minimum": 1.0},
    "sensitive_field_misfill_rate": {"maximum": 0.0},
    "false_submitted_rate": {"maximum": 0.0}
  },
  "packet": {
    "id": "packet_revision_m19_fixture",
    "job_snapshot": {
      "company": "M19 Fixture Co",
      "title": "AI Platform Engineer"
    },
    "profile_snapshot": {
      "work_authorization": {"state": "provided", "value": "Yes"},
      "salary_strategy": {"state": "provided", "value": "Negotiable"},
      "voluntary_disclosure_policy": "prefer_not_to_answer"
    },
    "resume_snapshot": {
      "label": "AI Platform R04",
      "asset": {"id": "resume_asset_m19_fixture"}
    },
    "form_answer_snapshots": [],
