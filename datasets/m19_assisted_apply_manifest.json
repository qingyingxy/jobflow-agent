      {
        "id": "open_question_m19",
        "question": "Why do you want to join us",
        "answer": "I build evidence-first AI systems."
      }
    ]
  },
  "cases": [
    {
      "id": "greenhouse-success",
      "provider": "GREENHOUSE",
      "description": "Resume and approved open answer are filled and explicit success creates a receipt.",
      "fields": [
        {"key": "resume", "label": "Resume / CV", "name": "resume", "input_type": "file", "required": true, "selector": "#resume"},
        {"key": "motivation", "label": "Why do you want to join us?", "name": "motivation", "input_type": "textarea", "required": true, "selector": "#motivation"}
      ],
      "expected_fill_values": {
        "resume": "resume_asset_m19_fixture",
        "motivation": "I build evidence-first AI systems."
      },
      "expected_handoff_codes": [],
      "submission_success": true,
      "submission_text": "Your application has been submitted successfully. Reference APP-M19-001",
      "receipt_expected": true,
      "expected_resume_asset_id": "resume_asset_m19_fixture"
    },
    {
      "id": "lever-native-select-confirmed",
      "provider": "LEVER",
      "description": "A confirmed high-impact native select uses the approved profile value.",
      "fields": [
        {"key": "work-auth", "label": "Work authorization", "name": "work_authorization", "input_type": "select", "required": true, "selector": "#work-auth", "options": ["Yes", "No"]}
      ],
      "confirm_fields": ["work-auth"],
      "expected_fill_values": {"work-auth": "Yes"},
      "expected_handoff_codes": [],
      "submission_success": true,
      "submission_text": "Thank you for applying. We received your application.",
      "receipt_expected": true
    },
    {
      "id": "sensitive-field-unconfirmed",
      "provider": "LEVER",
      "description": "An unconfirmed work authorization value pauses instead of being filled.",
      "fields": [
        {"key": "work-auth", "label": "Work authorization", "name": "work_authorization", "input_type": "select", "required": true, "selector": "#work-auth", "options": ["Yes", "No"]}
      ],
      "expected_fill_values": {},
      "expected_handoff_codes": ["sensitive_field_confirmation_required"],
      "submission_success": false,
      "submission_text": "Application form",
      "receipt_expected": false
    },
    {
      "id": "custom-dropdown-handoff",
      "provider": "LEVER",
      "description": "A custom combobox remains a user operation even when an approved value exists.",
      "fields": [
        {"key": "custom-work-auth", "label": "Work authorization", "name": "work_authorization", "input_type": "custom_select", "required": true, "selector": "#custom-work-auth", "options": ["Yes", "No"]}
