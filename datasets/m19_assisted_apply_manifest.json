      "changed_fields": [
        {"key": "resume", "label": "Resume / CV", "name": "resume", "input_type": "file", "required": true, "selector": "#resume"},
        {"key": "new-required", "label": "New required question", "name": "new_required", "input_type": "textarea", "required": true, "selector": "#new-required"}
