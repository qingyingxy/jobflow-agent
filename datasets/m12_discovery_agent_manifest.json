{
  "manifest_version": "m12-discovery-agent-manifest-v1",
  "dataset_version": "m12-discovery-agent-fixtures-2026-08-09-v1",
  "purpose": "使用固定离线响应回归验证 Discovery Agent 的来源授权、工具路由、回退、人工接管、预算和状态一致性。",
  "source_policy": "所有场景只允许访问内存 Fixture 或被安全检查器预先拒绝的地址；不发送真实官网请求。",
  "thresholds": {
    "case_pass_rate": {"minimum": 1.0},
    "unauthorized_source_access_rate": {"maximum": 0.0},
    "trace_completeness_rate": {"minimum": 1.0},
    "tool_route_accuracy": {"minimum": 1.0},
    "fallback_correctness_rate": {"minimum": 1.0},
    "non_job_false_accept_rate": {"maximum": 0.0},
    "human_gate_accuracy": {"minimum": 1.0},
    "budget_compliance_rate": {"minimum": 1.0},
    "state_consistency_rate": {"minimum": 1.0}
  },
  "cases": [
    {
      "id": "M12-001",
      "category": "source_authorization",
      "fixture": "unknown_company_blocked",
      "description": "未登记公司必须在构造 Adapter 前被拒绝，且不能发生网络访问。",
      "expected": {"unauthorized_access_occurred": false}
    },
    {
      "id": "M12-002",
      "category": "source_authorization",
      "fixture": "private_url_blocked",
      "description": "解析到本机地址的 URL 必须在 HTTP 请求发出前被拒绝。",
      "expected": {"unauthorized_access_occurred": false}
    },
    {
      "id": "M12-003",
      "category": "tool_routing",
      "fixture": "bytedance_success",
      "description": "字节来源优先使用专用公开职位 Adapter，并保留完整轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "M12-004",
      "category": "tool_routing",
      "fixture": "tencent_success",
      "description": "腾讯来源优先使用专用公开职位 Adapter，并保留完整轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "M12-005",
      "category": "adapter_fallback",
      "fixture": "bytedance_failure_static_success",
      "description": "字节专用 Adapter 失败后按计划回退静态岗位链接读取。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "M12-006",
      "category": "adapter_fallback",
      "fixture": "tencent_empty_static_success",
      "description": "腾讯专用 Adapter 返回空结果后按计划回退静态岗位链接读取。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "M12-007",
      "category": "human_gate",
      "fixture": "dynamic_shell_human_gate",
      "description": "无法静态验证岗位的动态页面不得入库，并进入人工 JD 接管。",
      "expected": {
        "discovered_count": 0,
        "trace_complete": true,
        "tool_route_correct": true,
        "non_job_accepted": false,
        "human_gate_correct": true
      }
    },
    {
      "id": "M12-008",
      "category": "non_job_rejection",
      "fixture": "guideline_rejected",
      "description": "校园招聘指南页不得误判为具体岗位，并进入人工 JD 接管。",
      "expected": {
        "discovered_count": 0,
        "trace_complete": true,
        "tool_route_correct": true,
        "non_job_accepted": false,
        "human_gate_correct": true
      }
    },
    {
      "id": "M12-009",
      "category": "structured_extraction",
      "fixture": "jsonld_job_accepted",
      "description": "合法 JobPosting JSON-LD 必须通过统一候选验证并保留来源轨迹。",
      "expected": {
        "discovered_count": 1,
        "strict_count": 1,
        "trace_complete": true,
        "tool_route_correct": true
      }
    },
    {
      "id": "M12-010",
      "category": "failure_isolation",
      "fixture": "source_failure_isolated",
      "description": "一个来源读取失败时，其他来源的有效岗位仍必须保留并继续处理。",
      "expected": {
        "discovered_count": 1,
        "trace_complete": true,
        "tool_route_correct": true,
        "fallback_correct": true
      }
    },
    {
      "id": "M12-011",
      "category": "budget",
      "fixture": "result_and_analysis_budget",
      "description": "25 条候选只能保留 Top20，且仅严格匹配的 Top5 标记为自动分析目标。",
      "expected": {
        "discovered_count": 20,
        "strict_count": 20,
        "trace_complete": true,
        "tool_route_correct": true,
        "budget_compliant": true
      }
    },
    {
      "id": "M12-012",
      "category": "analysis_gate",
      "fixture": "strict_expanded_gate",
      "description": "拓展候选可以展示，但不能挤占严格匹配岗位的自动分析预算。",
      "expected": {
        "discovered_count": 2,
        "strict_count": 1,
        "expanded_count": 1,
        "trace_complete": true,
        "budget_compliant": true
      }
    },
    {
      "id": "M12-013",
      "category": "state_idempotency",
      "fixture": "duplicate_rerun_idempotent",
      "description": "同一岗位重复发现不得创建重复 JobPosting 或 CandidateJob。",
      "expected": {
        "discovered_count": 1,
        "duplicate_count": 1,
        "trace_complete": true,
        "state_consistent": true
      }
    }
  ]
}
