  "v6_mechanism": {
    "name": "region-local-supported-delta-compatibility-router",
    "implementation_target": "src/domain/unified_jd_structured_spans_v6.py",
    "composition": "Run the byte-frozen v4 and v5 parsers, align their nodes to exact top-level source regions, and merge only licensed v5 region subgraphs. Frozen v4 is the default for every unlicensed or conflicted region.",
    "ordered_stages": [
      {
        "order": 1,
        "name": "dual_frozen_parse",
        "rule": "Execute the frozen v4 and v5 parsers once each for the same source_text and category. Neither parser source may be changed."
      },
      {
        "order": 2,
        "name": "exact_region_alignment",
        "rule": "Assign wrappers, connectors, members, scopes, attachments, and candidates to half-open top-level source regions by span containment. Cross-region attachments retain their cue region and source-anchored parent span."
      },
      {
        "order": 3,
        "name": "license_supported_activation",
        "rule": "A region may use a v5 delta only for: an explicit 如 cue including 如 followed by a colon; a protected parenthetical attachment; an E7 leading-对 attachment ending in 等领域 or 等方面; an E6 direct open list governed by an immediately preceding deictic 以下… header and colon; or a structural wrapper decomposition where v5 creates at least one explicit coordination, scope, or attachment inside that same wrapper content."
      },
      {
        "order": 4,
        "name": "apply_role_conflict_guard",
        "rule": "For a no-explicit-cue 等 enumeration, if v4 projects the same source spans as surface items while v5 only reclassifies them as examples, keep the v4 region unless the independently licensed E6 or E7 signature is present."
      },
      {
        "order": 5,
        "name": "preserve_protected_compatibility",
        "rule": "Reject a v5 region delta that deletes a v4 protected parenthetical attachment without a source-covering replacement, or changes a v4 atomic/slash/scope-bearing projection outside the licensed delta span."
      },
      {
        "order": 6,
        "name": "bound_open_list_activation",
        "rule": "An open_list_suffix wrapper from terminal 等优先 is retained only for the deictic-header-plus-colon E6 form. A plain list ending 等优先 retains the frozen v4 wrapper graph."
      },
      {
        "order": 7,
        "name": "region_local_merge",
        "rule": "Start from the v4 graph, replace only licensed and unconflicted region nodes with their v5 counterparts, then deterministically rebase ids and scope member references. No whole-clause fresh dispatch is permitted."
      },
      {
        "order": 8,
        "name": "validate_and_project",
        "rule": "Validate all spans, ids, scope edges, and attachment edges, then project from the merged graph without string rewriting or canonicalization."
      }
    ],
    "precedence": [
      "source anchoring and graph validity",
      "compatibility veto",
      "licensed v5 region delta",
      "frozen v4 default"
    ],
    "runtime_prohibitions": [
      "fixture id, file path, company, title, category, or gold lookup",
      "expected or actual projection string equality lookup",
      "classification-case id lookup",
      "new lexical canonicalization",
      "model or network calls"
    ]
  },
