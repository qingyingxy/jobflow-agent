APP_ENV=development
# SQLite-only storage. The database file is created under ./data.
DATABASE_URL=sqlite:///./data/jobflow.db
DEFAULT_USER_ID=local-user
# Private resume files are stored outside frontend/static paths.
PRIVATE_STORAGE_DIR=./data/private
RESUME_MAX_BYTES=5242880
# Maximum in-memory ZIP size for one explicit account export request.
ACCOUNT_EXPORT_MAX_BYTES=104857600
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# local is development-only. Use oidc for direct Bearer JWT verification, or
# trusted_header behind a gateway that strips client copies of the identity header.
AUTH_MODE=local
ALLOW_INSECURE_USER_HEADER=true
TRUSTED_IDENTITY_HEADER=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_HTTP_TIMEOUT_SECONDS=5
DISCOVERY_RUN_TIMEOUT_SECONDS=3600
# auto uses Tavily when a key is present, otherwise the zero-config Bing RSS fallback.
WEB_SEARCH_PROVIDER=auto
# rule keeps the existing strategy; agent selects bounded queries within company scope.
# Agent decisions reuse the structured model configuration below.
WEB_SEARCH_DECISION_MODE=agent
# Includes one possible validation repair per decision; transport retries disabled.
WEB_SEARCH_DECISION_MAX_CALLS=6
WEB_SEARCH_DECISION_TIMEOUT_SECONDS=12
# Bounded review of public JD duties only; no resume is sent.
WEB_SEARCH_ROLE_REVIEW_ENABLED=true
WEB_SEARCH_ROLE_REVIEW_MAX_CALLS=12
WEB_SEARCH_ROLE_REVIEW_BATCH_SIZE=2
WEB_SEARCH_ROLE_REVIEW_CONCURRENCY=2
WEB_SEARCH_ROLE_REVIEW_TIMEOUT_SECONDS=15
WEB_SEARCH_SEMANTIC_ENABLED=true
WEB_SEARCH_UNDERSTANDING_MODE=ai
WEB_SEARCH_SEMANTIC_LISTING_MAX_CALLS=6
WEB_SEARCH_SEMANTIC_MAX_CALLS=16
WEB_SEARCH_SEMANTIC_HISTORY_MAX_CALLS=4
WEB_SEARCH_SEMANTIC_RECOVERY_MAX_CALLS=4
WEB_SEARCH_SEMANTIC_CONCURRENCY=2
WEB_SEARCH_SEMANTIC_TIMEOUT_SECONDS=12
WEB_SEARCH_SEMANTIC_RETRY_TIMEOUT_SECONDS=30
# Read registered official listings first, including observed site search controls.
# Reads current site filters and full official payloads; shares the existing search time budget.
WEB_SEARCH_DIRECT_SOURCES_ENABLED=true
WEB_SEARCH_MAX_ROUNDS=6
WEB_SEARCH_BUDGET_SECONDS=300
# Each dispatched request, including a retry, consumes one search round.
WEB_SEARCH_REQUEST_TIMEOUT_SECONDS=60
WEB_SEARCH_TRANSIENT_RETRIES=1
WEB_SEARCH_TARGET_JOBS=15
WEB_SEARCH_COMPANY_TARGET=3
WEB_SEARCH_COMPANY_SECONDS=30
# Different company websites may load together; each company still verifies jobs sequentially.
WEB_SEARCH_COMPANY_CONCURRENCY=4
# Saved goals rotate through this many companies per run, preserving progress.
WEB_SEARCH_COMPANY_BATCH_SIZE=6
# Saved goals without a fixed company scope discover and verify new sources in parallel.
# Requires a real structured model; at most 2 search calls and 1 extraction call per run.
COMPANY_DISCOVERY_ENABLED=true
COMPANY_DISCOVERY_REQUEST_TIMEOUT_SECONDS=60
COMPANY_DISCOVERY_TOOL_CALLS=1
COMPANY_DISCOVERY_BUDGET_SECONDS=90
COMPANY_DISCOVERY_MAX_CANDIDATES=2
# Discovery and verification have independent budgets; max rounds = actual queries.
WEB_SEARCH_VERIFICATION_BUDGET_SECONDS=180
WEB_SEARCH_VERIFICATION_ITEM_SECONDS=60
WEB_SEARCH_ENTRY_LIMIT=8
WEB_SEARCH_ENTRY_BUDGET_SECONDS=45
WEB_SEARCH_ENTRY_ITEM_SECONDS=15
WEB_SEARCH_ENTRY_EMPTY_LIMIT=2
WEB_SEARCH_ENTRY_MAX_PAGES=6
WEB_SEARCH_ENTRY_MAX_DETAILS=20
# responses reuses LLM_BASE_URL / LLM_API_KEY / LLM_MODEL with hosted web_search.
# Enable explicitly only when the configured provider supports /responses.
TAVILY_API_KEY=
# One-time ATS submission authorization lifetime. Tokens are never persisted raw.
ATS_AUTHORIZATION_TTL_SECONDS=600
LOG_LEVEL=INFO

# Optional local HTTP proxy, for example Mihomo/Clash at http://127.0.0.1:7890.
# Only registered official recruiting hosts use this proxy-aware DNS path.
URL_FETCH_PROXY=
# Keep false for strict host allowlisting. Set true only when the local proxy
# resolves public recruiting redirects (for example Mihomo Fake-IP mode).
URL_FETCH_PROXY_ALLOW_UNLISTED_HOSTS=false

# M04 structured JD parser. Fake keeps local development independent of a model API.
STRUCTURED_MODEL_PROVIDER=fake
LLM_BASE_URL=
LLM_RESPONSE_FORMAT=auto
# auto disables DeepSeek thinking for deterministic structured extraction and
# omits the provider-specific parameter for other OpenAI-compatible endpoints.
LLM_THINKING_MODE=auto
# OpenAI-compatible reasoning depth: auto, none, minimal, low, medium, high, xhigh.
LLM_REASONING_EFFORT=auto
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
PARSER_VALIDATION_RETRIES=1
PRODUCT_PARSE_MODE=two_stage
PRODUCT_PROMPT_VERSION=product-jd-two-stage-v12
PRODUCT_SINGLE_CALL_PROMPT_VERSION=product-jd-single-call-v4-inline
PRODUCT_PARSER_VERSION=product-jd-parser-v10
# Product JD parsing owns transport retries and counts every provider request.
# Bounds apply to the entire parse, including both stages and validation repair.
PRODUCT_PARSE_TRANSPORT_RETRIES=1
PRODUCT_PARSE_RETRY_BACKOFF_SECONDS=1.5
PRODUCT_PARSE_RUN_TIMEOUT_SECONDS=300
PRODUCT_PARSE_MAX_MODEL_CALLS=6
# semantic sends saved experience sentences/titles/skills to the configured LLM.
# Enable only after approving this use of resume evidence. local makes no matching call.
EVIDENCE_MATCHING_MODE=local
EVIDENCE_MATCHING_TIMEOUT_SECONDS=60
PROMPT_VERSION=jd-parser-prompt-v4
PARSER_VERSION=jd-parser-v3
CORE_PROMPT_VERSION=jd-core-parser-prompt-v24
CORE_PARSER_VERSION=jd-core-parser-v39
DETAIL_PROMPT_VERSION=jd-detail-parser-prompt-v1
STAGED_PROMPT_VERSION=jd-staged-parser-prompt-v2
STAGED_PARSER_VERSION=jd-staged-parser-v17
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Screenshot fallback uses the same endpoint/key; model must support image input.
VISION_FALLBACK_ENABLED=true
# Empty uses LLM_MODEL; set a vision-capable model if the text model lacks images.
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30
