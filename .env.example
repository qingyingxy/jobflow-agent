APP_ENV=development
# SQLite-only storage. The database file is created under ./data.
DATABASE_URL=sqlite:///./data/jobflow.db
DEFAULT_USER_ID=local-user
# Private resume files are stored outside frontend/static paths.
PRIVATE_STORAGE_DIR=./data/private
RESUME_MAX_BYTES=5242880
# Maximum in-memory ZIP size for one explicit account export request.
ACCOUNT_EXPORT_MAX_BYTES=104857600
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# local is development-only. Use oidc for direct Bearer JWT verification, or
# trusted_header behind a gateway that strips client copies of the identity header.
AUTH_MODE=local
ALLOW_INSECURE_USER_HEADER=true
TRUSTED_IDENTITY_HEADER=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_HTTP_TIMEOUT_SECONDS=5
DISCOVERY_RUN_TIMEOUT_SECONDS=3600
# auto uses Tavily when a key is present, otherwise the zero-config Bing RSS fallback.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# One-time ATS submission authorization lifetime. Tokens are never persisted raw.
ATS_AUTHORIZATION_TTL_SECONDS=600
LOG_LEVEL=INFO

# Optional local HTTP proxy, for example Mihomo/Clash at http://127.0.0.1:7890.
# Only registered official recruiting hosts use this proxy-aware DNS path.
URL_FETCH_PROXY=
# Keep false for strict host allowlisting. Set true only when the local proxy
# resolves public recruiting redirects (for example Mihomo Fake-IP mode).
URL_FETCH_PROXY_ALLOW_UNLISTED_HOSTS=false

# M04 structured JD parser. Fake keeps local development independent of a model API.
STRUCTURED_MODEL_PROVIDER=fake
LLM_BASE_URL=
LLM_RESPONSE_FORMAT=auto
# auto disables DeepSeek thinking for deterministic structured extraction and
# omits the provider-specific parameter for other OpenAI-compatible endpoints.
LLM_THINKING_MODE=auto
# OpenAI-compatible reasoning depth: auto, none, minimal, low, medium, high, xhigh.
LLM_REASONING_EFFORT=auto
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
PARSER_VALIDATION_RETRIES=1
PRODUCT_PROMPT_VERSION=product-jd-two-stage-v6
PRODUCT_PARSER_VERSION=product-jd-parser-v3
PROMPT_VERSION=jd-parser-prompt-v4
PARSER_VERSION=jd-parser-v3
CORE_PROMPT_VERSION=jd-core-parser-prompt-v24
CORE_PARSER_VERSION=jd-core-parser-v39
DETAIL_PROMPT_VERSION=jd-detail-parser-prompt-v1
STAGED_PROMPT_VERSION=jd-staged-parser-prompt-v2
STAGED_PARSER_VERSION=jd-staged-parser-v17
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
