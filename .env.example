APP_ENV=development
# SQLite-first local development. The database file is created under ./data.
DATABASE_URL=sqlite:///./data/jobflow.db
DEFAULT_USER_ID=local-user
# Private resume files are stored outside frontend/static paths.
PRIVATE_STORAGE_DIR=./data/private
RESUME_MAX_BYTES=5242880
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DISCOVERY_RUN_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO

# Optional local HTTP proxy, for example Mihomo/Clash at http://127.0.0.1:7890.
# Only registered official recruiting hosts use this proxy-aware DNS path.
URL_FETCH_PROXY=
# Keep false for strict host allowlisting. Set true only when the local proxy
# resolves public recruiting redirects (for example Mihomo Fake-IP mode).
URL_FETCH_PROXY_ALLOW_UNLISTED_HOSTS=false

# Optional PostgreSQL + pgvector path, with PostgreSQL running through Docker Compose:
# DATABASE_URL=postgresql+psycopg://jobflow:jobflow@localhost:5432/jobflow?connect_timeout=3
# If the API is later added to the same Compose network, use:
# DATABASE_URL=postgresql+psycopg://jobflow:jobflow@postgres:5432/jobflow

# M04 structured JD parser. Fake keeps local development independent of a model API.
STRUCTURED_MODEL_PROVIDER=fake
LLM_BASE_URL=
LLM_RESPONSE_FORMAT=auto
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
PARSER_VALIDATION_RETRIES=1
PROMPT_VERSION=jd-parser-prompt-v4
PARSER_VERSION=jd-parser-v3
CORE_PROMPT_VERSION=jd-core-parser-prompt-v1
CORE_PARSER_VERSION=jd-core-parser-v1
DETAIL_PROMPT_VERSION=jd-detail-parser-prompt-v1
STAGED_PROMPT_VERSION=jd-staged-parser-prompt-v1
STAGED_PARSER_VERSION=jd-staged-parser-v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
